# ===========================================
# SecureWork Verify - Backend Environment
# ===========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ===========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/securework-verify

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Key Storage (local development only)
# Production: use KMS/Secrets Manager/HSM
KEY_STORAGE_PATH=./keys

# Document Storage (local development only)
# Format: path relative to backend/ directory
# Production: swap for Firebase Storage / S3 / GCS adapter
DOCUMENT_STORAGE_PATH=./uploads

# File upload limits
MAX_FILE_SIZE_MB=10

# Admin Seed (used by scripts/seed.js)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@securework.local
ADMIN_PASSWORD=Admin@123456
